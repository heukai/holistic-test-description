{
  "@context": {
    "@version": 1.1,
    "htd": "https://w3id.org/erigrid/htd-o#",
    "scm": "https://w3id.org/erigrid/scm-o#",
    "scmd": "https://w3id.org/erigrid/scm-o/domains#",
    "dcterms": "http://purl.org/dc/terms/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",
    "graph": "@graph",

    "name": "rdfs:label",
    "description": "dcterms:description",
    "author": "dcterms:creator",
    "version": "owl:versionInfo",
    "date": {"@id": "dcterms:date", "@type": "xsd:date"},
    "source": {"@id": "dcterms:source", "@type": "@id"},
    "format": "dcterms:format",
    "value": "rdf:value",
    "status": "htd:descriptionStatus",

    "project": "htd:project",
    "narrative": "htd:narrative",
    "purposes": {"@id": "htd:hasPurposeOfInvestigation", "@type": "@id", "@container": "@set"},
    "poiType": {"@id": "htd:hasPoIType", "@type": "@vocab"},
    "concernsObject": {"@id": "htd:concernsObject", "@type": "@id", "@container": "@set"},
    "concernsFunction": {"@id": "htd:concernsFunction", "@type": "@id", "@container": "@set"},
    "objectsUnderInvestigation": {"@id": "htd:hasObjectUnderInvestigation", "@type": "@id", "@container": "@set"},
    "systemUnderTest": {"@id": "htd:hasSystemUnderTest", "@type": "@id"},
    "domainsUnderInvestigation": {"@id": "htd:hasDomainUnderInvestigation", "@type": "@id", "@container": "@set"},
    "functionsUnderInvestigation": {"@id": "htd:hasFunctionUnderInvestigation", "@type": "@id", "@container": "@set"},
    "functionsUnderTest": {"@id": "htd:hasFunctionUnderTest", "@type": "@id", "@container": "@set"},
    "realisedBy": {"@id": "htd:realisedBy", "@type": "@id", "@container": "@set"},
    "specification": "htd:functionSpecification",

    "criteria": {"@id": "htd:hasTestCriteria", "@type": "@id", "@container": "@set"},
    "refinesCriteria": {"@id": "htd:refinesCriteria", "@type": "@id"},
    "targetMetrics": {"@id": "htd:hasTargetMetric", "@type": "@id", "@container": "@set"},
    "measurementType": "htd:measurementType",
    "unit": "htd:unit",
    "variabilityAttributes": {"@id": "htd:hasVariabilityAttribute", "@type": "@id", "@container": "@set"},
    "controllability": {"@id": "htd:controllability", "@type": "@vocab"},
    "variabilityRange": "htd:variabilityRange",
    "actsOn": {"@id": "htd:actsOn", "@type": "@id", "@container": "@set"},
    "qualityAttributes": {"@id": "htd:hasQualityAttribute", "@type": "@id", "@container": "@set"},
    "forMetric": {"@id": "htd:forMetric", "@type": "@id"},
    "threshold": "htd:threshold",

    "qualificationStrategy": {"@id": "htd:hasQualificationStrategy", "@type": "@id"},
    "testCase": {"@id": "dcterms:isPartOf", "@type": "@id"},
    "testObject": {"@id": "htd:hasTestObject", "@type": "@id", "@container": "@set"},
    "testSystem": {"@id": "htd:hasTestSystem", "@type": "@id"},
    "testingApproach": "htd:testingApproach",
    "qualifiesCriteria": {"@id": "htd:qualifiesCriteria", "@type": "@id", "@container": "@set"},
    "contributesToCriteria": {"@id": "htd:contributesToCriteria", "@type": "@id", "@container": "@set"},
    "combinationRule": "htd:combinationRule",
    "prerequisiteFor": {"@id": "htd:prerequisiteFor", "@type": "@id", "@container": "@set"},
    "precedes": {"@id": "htd:precedes", "@type": "@id", "@container": "@set"},
    "variesAttribute": {"@id": "htd:variesAttribute", "@type": "@id", "@container": "@set"},
    "rationale": "htd:testRationale",
    "inputParameters": {"@id": "htd:inputParameter", "@container": "@set"},
    "outputParameters": {"@id": "htd:outputParameter", "@container": "@set"},
    "testDesign": "htd:testDesign",
    "initialState": "htd:initialState",
    "stateEvolution": "htd:stateEvolution",
    "otherParameters": "htd:otherParameters",
    "temporalResolution": "htd:temporalResolution",
    "uncertaintySources": {"@id": "htd:uncertaintySource", "@type": "@id", "@container": "@set"},
    "stoppingCriteria": "htd:stoppingCriteria",

    "scType": {"@id": "htd:hasSCType", "@type": "@vocab"},
    "representations": {"@id": "htd:hasRepresentation", "@type": "@id", "@container": "@set"},
    "representationFormat": {"@id": "htd:representationFormat", "@type": "@vocab"},

    "containerSCType": {"@id": "scm:hasSCType", "@type": "@vocab"},
    "representsArtifact": {"@id": "scm:representsHTDArtifact", "@type": "@id"},
    "contains": {"@id": "scm:contains", "@type": "@id", "@container": "@set"},
    "identifier": "scm:identifier",
    "terminals": {"@id": "scm:hasTerminal", "@type": "@id", "@container": "@set"},
    "domain": {"@id": "scm:hasDomain", "@type": "@id"},
    "parentDomain": {"@id": "scm:parentDomain", "@type": "@id"},
    "joins": {"@id": "scm:joins", "@type": "@id", "@container": "@set"}
  }
}
