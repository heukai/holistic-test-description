        "tc:cp2",
        "tc:cp3",
        "tc:cp4",
        "tc:cp5",
        "tc:Haptic",
        "tc:Photometric"
      ]
    },
    {
      "id": "tc:SuT-region",
      "type": "scm:Region",
      "name": "System under Test",
      "members": [
        "tc:ss1",
