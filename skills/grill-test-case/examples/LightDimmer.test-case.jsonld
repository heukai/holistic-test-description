  "graph": [
    {
      "id": "tc:TC",
      "type": "htd:TestCase",
      "identifier": "LightDimmer",
      "name": "Light Dimmer",
      "author": "Tue V. Jensen",
      "project": "Distributed controller course",
      "version": "0.2",
      "date": "2026-11-21",
      "conformsTo": "https://w3id.org/erigrid/htd-o/core/0.2.0",
      "description": "Illustrative export of the LightDimmer example (Examples/BASIC_Light_Dimmer), restructured by the grill-test-case skill. Thresholds marked htd:Assumed are not in the original example.",
      "narrative": "A push-button light dimmer is marketed as working with any bulb on the market and being easy to operate for all users. This test case verifies that its switching, dimming and memory functions work as specified, characterizes how its dimming performance varies across LED and incandescent bulbs, and validates that users with different dexterity can operate it comfortably.",
      "objectsUnderInvestigation": [
        "tc:ss2"
      ],
      "systemUnderTest": "tc:SuT-region",
      "domainsUnderInvestigation": [
        "scmd:LV",
        "tc:Haptic",
        "tc:Photometric"
      ],
      "functionsUnderInvestigation": [
        "tc:FuI1",
        "tc:FuI2",
        "tc:FuI3"
      ],
      "functionsUnderTest": [
        "tc:FuI1",
        "tc:FuI2",
        "tc:FuI3",
        "tc:FuT4",
        "tc:FuT5"
      ],
      "purposes": [
        "tc:PoI1",
        "tc:PoI2",
        "tc:PoI3"
      ],
      "qualificationStrategy": "tc:QS"
    },
    {
      "id": "tc:FuI1",
      "type": "htd:Function",
      "identifier": "FuI1",
      "name": "Toggle",
      "specification": "A single tap toggles the light between on and off.",
      "realisedBy": [
        "tc:ss2"
      ]
    },
    {
      "id": "tc:FuI2",
      "type": "htd:Function",
      "identifier": "FuI2",
      "name": "Dim / brighten",
      "specification": "While on, a long hold first dims, then brightens the light.",
      "realisedBy": [
        "tc:ss2"
      ]
    },
    {
      "id": "tc:FuI3",
      "type": "htd:Function",
      "identifier": "FuI3",
      "name": "Level memory",
      "specification": "When turned on, the light resumes its previous dimming level.",
      "realisedBy": [
        "tc:ss2"
      ]
    },
    {
      "id": "tc:FuT4",
      "type": "htd:Function",
      "identifier": "FuT4",
      "name": "Bulb light emission",
      "realisedBy": [
        "tc:ss3"
      ]
    },
    {
      "id": "tc:FuT5",
      "type": "htd:Function",
      "identifier": "FuT5",
      "name": "LV supply",
      "realisedBy": [
        "tc:ss1"
      ]
    },
    {
      "id": "tc:PoI1",
      "type": "htd:PurposeOfInvestigation",
      "identifier": "PoI1",
      "poiKind": "htd:Verification",
      "status": "htd:Settled",
      "name": "Verify that the dimmer's toggle, dim/brighten and level-memory functions operate as specified.",
      "concernsObject": [
        "tc:ss2"
      ],
      "concernsFunction": [
        "tc:FuI1",
        "tc:FuI2",
        "tc:FuI3"
      ]
    },
    {
      "id": "tc:PoI2",
      "type": "htd:PurposeOfInvestigation",
      "identifier": "PoI2",
      "poiKind": "htd:Characterization",
      "status": "htd:Settled",
      "name": "Characterize how the dimming performance varies across LED and incandescent bulbs.",
      "concernsObject": [
        "tc:ss2"
      ],
      "concernsFunction": [
        "tc:FuI2",
        "tc:FuT4"
      ],
      "dependsOnPoI": [
        "tc:PoI1"
      ]
    },
    {
      "id": "tc:PoI3",
      "type": "htd:PurposeOfInvestigation",
      "identifier": "PoI3",
      "poiKind": "htd:Validation",
      "status": "htd:Settled",
      "name": "Validate that users with different dexterity can operate the switch comfortably.",
      "concernsObject": [
        "tc:ss2"
      ],
      "concernsFunction": [
        "tc:FuI1",
        "tc:FuI2"
      ]
    },
    {
      "id": "tc:TCR1a",
      "type": "htd:TestCriterion",
      "identifier": "TCR1a",
      "forPoI": [
        "tc:PoI1"
      ],
      "name": "On/off state and restored level are correct",
      "judgesPropertyOf": [
        "tc:ss2"
      ]
    },
    {
      "id": "tc:TCR1b",
      "type": "htd:TestCriterion",
      "identifier": "TCR1b",
      "forPoI": [
        "tc:PoI2"
      ],
      "name": "Dimming range per bulb, relative to its undimmed baseline",
      "judgesPropertyOf": [
        "tc:ss2"
      ],
      "combinationRule": "TM2 = dimmed brightness from TS3 divided by baseline brightness from TS1, per bulb sample; pooled per bulb type."
    },
    {
      "id": "tc:TCR2",
      "type": "htd:TestCriterion",
      "identifier": "TCR2",
      "forPoI": [
        "tc:PoI2"
      ],
      "name": "Flicker per bulb and dimming level",
      "judgesPropertyOf": [
        "tc:ss3"
      ]
    },
    {
      "id": "tc:TCR3",
      "type": "htd:TestCriterion",
      "identifier": "TCR3",
      "forPoI": [
        "tc:PoI3"
      ],
      "name": "Touch feedback and click sound are acceptable",
      "judgesPropertyOf": [
        "tc:ss2"
      ]
    },
    {
      "id": "tc:TM1",
      "type": "htd:TargetMetric",
      "identifier": "TM1",
      "forCriterion": [
        "tc:TCR1a",
        "tc:TCR1b"
      ],
      "name": "Brightness",
      "unit": "lm",
      "measurementType": "quantitative"
    },
    {
      "id": "tc:TM2",
      "type": "htd:TargetMetric",
      "identifier": "TM2",
      "forCriterion": [
        "tc:TCR1b"
      ],
      "name": "Relative dimming range",
      "unit": "%",
      "measurementType": "quantitative"
    },
    {
      "id": "tc:TM3",
      "type": "htd:TargetMetric",
      "identifier": "TM3",
      "forCriterion": [
        "tc:TCR2"
      ],
      "name": "Short-term light flicker Pst_LM (IEC TR 61547-1)",
      "unit": "1",
      "measurementType": "quantitative"
    },
    {
      "id": "tc:TM4",
      "type": "htd:TargetMetric",
      "identifier": "TM4",
      "forCriterion": [
        "tc:TCR3"
      ],
      "name": "Haptic satisfaction score",
      "unit": "Likert 1-5",
      "measurementType": "qualitative"
    },
    {
      "id": "tc:VA1",
      "type": "htd:VariabilityAttribute",
      "identifier": "VA1",
      "forPoI": [
        "tc:PoI2"
      ],
      "name": "LV supply voltage",
      "controllability": "htd:Uncontrollable",
      "variabilityRange": "normal(mean = nominal, sd = 5 % of nominal)",
      "actsOn": [
        "tc:ss1"
      ]
    },
    {
      "id": "tc:VA2",
      "type": "htd:VariabilityAttribute",
      "identifier": "VA2",
      "forPoI": [
        "tc:PoI2"
      ],
      "name": "Ambient light",
      "controllability": "htd:Uncontrollable",
      "variabilityRange": "[100, 1000] W/m2 equivalent irradiance",
      "actsOn": [
        "tc:ss5"
      ]
    },
    {
      "id": "tc:VA3",
      "type": "htd:VariabilityAttribute",
      "identifier": "VA3",
      "forPoI": [
        "tc:PoI1",
        "tc:PoI2"
      ],
      "name": "Bulb type",
      "controllability": "htd:Controllable",
      "variabilityRange": "{incandescent, LED}",
      "actsOn": [
        "tc:ss3"
      ]
    },
    {
      "id": "tc:VA4",
      "type": "htd:VariabilityAttribute",
      "identifier": "VA4",
      "forPoI": [
        "tc:PoI2"
      ],
      "name": "Bulb sample within type",
      "controllability": "htd:Uncontrollable",
      "variabilityRange": "normal around nominal ratings",
      "actsOn": [
        "tc:ss3"
      ]
    },
    {
      "id": "tc:VA5",
      "type": "htd:VariabilityAttribute",
      "identifier": "VA5",
      "forPoI": [
        "tc:PoI3"
      ],
      "name": "User press force and switching frequency",
      "controllability": "htd:Controllable",
      "variabilityRange": "users sampled across 3 sigma of the population distribution",
      "actsOn": [
        "tc:ss4"
      ]
    },
    {
      "id": "tc:QA1",
      "type": "htd:QualityAttribute",
      "identifier": "QA1",
      "forMetric": "tc:TM1",
      "threshold": "restored brightness within +/- 5 % of the level before switch-off",
      "thresholdProvenance": "htd:Assumed"
    },
    {
      "id": "tc:QA2",
      "type": "htd:QualityAttribute",
      "identifier": "QA2",
      "forMetric": "tc:TM2",
      "resultQuality": "95 % confidence interval per bulb type; p < 0.05 for differences between types"
    },
    {
      "id": "tc:QA3",
      "type": "htd:QualityAttribute",
      "identifier": "QA3",
      "forMetric": "tc:TM4",
      "threshold": "at least 80 % of users rate >= 4",
      "thresholdProvenance": "htd:Assumed"
    },
    {
      "id": "tc:QA4",
      "type": "htd:QualityAttribute",
      "identifier": "QA4",
      "forMetric": "tc:TM3",
      "resultQuality": "Pst_LM per bulb type and dimming level, 95 % confidence interval over bulb samples"
    },
    {
      "id": "tc:SuT",
      "type": "htd:GenericSystemConfigurationArtifact",
      "name": "LightDimmer SuT sketch (TC-GSC)",
      "scType": "htd:TC-GSC",
      "representations": [
        "tc:SuT-figure",
        "tc:SuT-graph"
      ]
    },
    {
      "id": "tc:SuT-figure",
      "type": "htd:SCRepresentation",
      "representationFormat": "htd:Diagram",
      "format": "text/vnd.mermaid",
      "value": "flowchart LR\n  ss1[\"ss1: LV grid\"] -- \"electrical: 230 V AC\" --> ss2\n  ss2[[\"ss2: Light dimmer (OuI)\"]] -- \"electrical: dimmed AC\" --> ss3[\"ss3: Bulb\"]\n  ss4([\"ss4: User\"]) -- \"haptic: press / hold\" --> ss2\n  ss3 -- \"photometric: light\" --> ss4\n  ss5([\"ss5: Ambient light\"]) -- \"photometric: ambient light\" --> ss4"
    },
    {
      "id": "tc:SuT-graph",
      "type": [
        "htd:SCRepresentation",
        "scm:SystemConfigurationContainer"
      ],
      "representationFormat": "htd:RDF_OWL",
      "representsArtifact": "tc:SuT",
      "containerSCType": "htd:TC-GSC",
      "contains": [
        "tc:SuT-region",
        "tc:ss1",
