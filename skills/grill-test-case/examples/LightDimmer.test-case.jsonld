      "id": "tc:ss3.t1",
      "type": "scm:Terminal",
      "domain": "scmd:LV"
    },
    {
      "id": "tc:ss3.t2",
      "type": "scm:Terminal",
      "domain": "tc:Photometric"
    },
    {
